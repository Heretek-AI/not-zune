<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:NotZune.UI.ViewModels;assembly=NotZune.UI"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="130"
             x:Class="NotZune.UI.Views.CompactMiniPlayerView"
             x:DataType="vm:MainShellViewModel"
             Background="{DynamicResource ZuneSurfaceElevatedBrush}">

  <Grid RowDefinitions="Auto,*,Auto" PointerPressed="OnMiniBarPointerPressed">
    <!-- 1. Top Mini System Bar: Brand Wordmark & Restore/Close Window Controls -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="12,6,8,2">
      <!-- Mini Brand Mark -->
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <Image Source="avares://NotZune.UI/Assets/Zune/Branding/ZUNECOLORLOGO.PNG" Width="14" Height="15" VerticalAlignment="Center" />
        <TextBlock Text="ZUNE MINI" 
                   FontFamily="{StaticResource ZunePivotFontFamily}" 
                   FontSize="10" 
                   FontWeight="Bold" 
                   LetterSpacing="2" 
                   Foreground="{DynamicResource ZuneTextDimmedBrush}" 
                   VerticalAlignment="Center" />
      </StackPanel>

      <!-- Window Action Controls: Restore & Close -->
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
        <Button Classes="window-control" Command="{Binding ToggleCompactModeCommand}" ToolTip.Tip="Restore to Full Zune Window">
          <Image Source="avares://NotZune.UI/Assets/Zune/Window/WINDOW.RESTORE.PNG" Width="13" Height="14" />
        </Button>
        <Button Classes="window-control window-close" Click="OnCloseClicked" ToolTip.Tip="Close">
          <Image Source="avares://NotZune.UI/Assets/Zune/Window/WINDOW.CLOSE.PNG" Width="13" Height="14" />
        </Button>
      </StackPanel>
    </Grid>

    <!-- 2. Hairline Seek Scrubber -->
    <ProgressBar Grid.Row="1" 
                 Height="2" 
                 CornerRadius="0"
                 VerticalAlignment="Top"
                 Value="{Binding ProgressPercentage}" 
                 Maximum="1.0" 
                 Foreground="{DynamicResource ZuneAccentBrush}" 
                 Background="#1E1E1E" />

    <!-- 3. Player Content & Transport Strip -->
    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="12,10,12,6" VerticalAlignment="Center">
      <!-- Left: Mini Square Album Art & Rating Badge -->
      <Border Grid.Column="0" 
              Width="44" Height="44" 
              Background="{DynamicResource ZuneCardBrush}" 
              BorderBrush="{DynamicResource ZuneBorderBrush}" 
              BorderThickness="1" 
              CornerRadius="0">
        <Grid>
          <TextBlock Text="♫" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ZuneTextDimmedBrush}" />
          <!-- Mini Heart badge if favorite -->
          <Image Source="avares://NotZune.UI/Assets/Zune/Rating/RATING.LIKEIT.SELECTED.PNG" 
                 IsVisible="{Binding IsFavorite}" 
                 Width="12" Height="11" 
                 HorizontalAlignment="Right" 
                 VerticalAlignment="Bottom" 
                 Margin="0,0,2,2" />
        </Grid>
      </Border>

      <!-- Center: Track Title & Artist Metadata -->
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,10,0" Spacing="2">
        <TextBlock Text="{Binding CurrentTrack.Title, FallbackValue='Not Playing'}" 
                   Classes="body" 
                   FontWeight="SemiBold" 
                   TextTrimming="CharacterEllipsis" 
                   MaxWidth="170" />
        <TextBlock Text="{Binding CurrentTrack.ArtistName, FallbackValue='Zune Player'}" 
                   Classes="caption" 
                   Foreground="{DynamicResource ZuneTextSecondaryBrush}" 
                   TextTrimming="CharacterEllipsis" 
                   MaxWidth="170" />
        <TextBlock Text="{Binding ElapsedTimeText}" 
                   Classes="caption" 
                   Foreground="{DynamicResource ZuneTextDimmedBrush}" 
                   FontSize="8" />
      </StackPanel>

      <!-- Right: Compact Transport Buttons -->
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <!-- Previous -->
        <Button Command="{Binding PreviousCommand}" Padding="4" ToolTip.Tip="Previous">
          <Image Source="avares://NotZune.UI/Assets/Zune/Transport/TRANSPORT.BACK.PNG" Width="20" Height="20" />
        </Button>

        <!-- Play / Pause -->
        <Button Command="{Binding PlayPauseCommand}" Padding="4" ToolTip.Tip="Play / Pause">
          <Panel Width="28" Height="28">
            <Image Source="avares://NotZune.UI/Assets/Zune/Transport/TRANSPORT.PLAY.PNG" IsVisible="{Binding !IsPlaying}" Width="28" Height="28" />
            <Image Source="avares://NotZune.UI/Assets/Zune/Transport/TRANSPORT.PAUSE.PNG" IsVisible="{Binding IsPlaying}" Width="28" Height="28" />
          </Panel>
        </Button>

        <!-- Next -->
        <Button Command="{Binding NextCommand}" Padding="4" ToolTip.Tip="Next">
          <Image Source="avares://NotZune.UI/Assets/Zune/Transport/TRANSPORT.FORWARD.PNG" Width="20" Height="20" />
        </Button>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
