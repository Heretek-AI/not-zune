<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:NotZune.UI.ViewModels;assembly=NotZune.UI"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="NotZune.UI.Views.DeviceView"
             x:DataType="vm:DeviceViewModel">

  <Grid Margin="40,20,40,20">
    <!-- State 1: Device Connected -->
    <StackPanel IsVisible="{Binding HasDevice}" Spacing="24" MaxWidth="720" HorizontalAlignment="Left">
      <StackPanel Spacing="4">
        <TextBlock Text="{Binding DeviceName}" Classes="hero" />
        <TextBlock Classes="caption" Foreground="{DynamicResource ZuneTextSecondaryBrush}">
          <TextBlock.Text>
            <MultiBinding StringFormat="{}SERIAL: {0} • FIRMWARE: {1}">
              <Binding Path="SerialNumber" />
              <Binding Path="FirmwareVersion" />
            </MultiBinding>
          </TextBlock.Text>
        </TextBlock>
      </StackPanel>

      <!-- Section: Storage Gas Gauge Meter -->
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="DEVICE STORAGE" Classes="section-header" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding StorageText}" Classes="caption" Foreground="{DynamicResource ZuneAccentBrush}" VerticalAlignment="Center" />
        </Grid>

        <!-- Segmented Multi-Color Gas Gauge Bar -->
        <Border BorderBrush="{DynamicResource ZuneBorderBrush}" BorderThickness="1" CornerRadius="0" Height="20" Background="#111111">
          <Grid x:Name="GasGaugeGrid">
            <!-- Music (Accent/Pink) -->
            <Border Grid.Column="0" Background="#FA2A55" ToolTip.Tip="{Binding MusicText}" CornerRadius="0" />
            <!-- Video (Amber/Orange) -->
            <Border Grid.Column="1" Background="#F09609" ToolTip.Tip="{Binding VideoText}" CornerRadius="0" />
            <!-- Pictures (Cyan) -->
            <Border Grid.Column="2" Background="#1BA1E2" ToolTip.Tip="{Binding PhotoText}" CornerRadius="0" />
            <!-- Podcasts (Lime) -->
            <Border Grid.Column="3" Background="#339933" ToolTip.Tip="{Binding PodcastText}" CornerRadius="0" />
            <!-- System / Other (Grey) -->
            <Border Grid.Column="4" Background="#555555" ToolTip.Tip="{Binding SystemText}" CornerRadius="0" />
            <!-- Free Space (Dark Charcoal) -->
            <Border Grid.Column="5" Background="#222222" ToolTip.Tip="{Binding FreeText}" CornerRadius="0" />
          </Grid>
        </Border>

        <!-- Color Legend Row -->
        <WrapPanel Margin="0,4,0,0">
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,8">
            <Border Width="10" Height="10" Background="#FA2A55" CornerRadius="0" />
            <TextBlock Text="{Binding MusicText}" Classes="caption" FontSize="10" Foreground="{DynamicResource ZuneTextSecondaryBrush}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,8">
            <Border Width="10" Height="10" Background="#F09609" CornerRadius="0" />
            <TextBlock Text="{Binding VideoText}" Classes="caption" FontSize="10" Foreground="{DynamicResource ZuneTextSecondaryBrush}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,8">
            <Border Width="10" Height="10" Background="#1BA1E2" CornerRadius="0" />
            <TextBlock Text="{Binding PhotoText}" Classes="caption" FontSize="10" Foreground="{DynamicResource ZuneTextSecondaryBrush}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,8">
            <Border Width="10" Height="10" Background="#339933" CornerRadius="0" />
            <TextBlock Text="{Binding PodcastText}" Classes="caption" FontSize="10" Foreground="{DynamicResource ZuneTextSecondaryBrush}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,8">
            <Border Width="10" Height="10" Background="#555555" CornerRadius="0" />
            <TextBlock Text="{Binding SystemText}" Classes="caption" FontSize="10" Foreground="{DynamicResource ZuneTextSecondaryBrush}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,8">
            <Border Width="10" Height="10" Background="#222222" BorderBrush="#444444" BorderThickness="1" CornerRadius="0" />
            <TextBlock Text="{Binding FreeText}" Classes="caption" FontSize="10" Foreground="{DynamicResource ZuneTextDimmedBrush}" />
          </StackPanel>
        </WrapPanel>

        <!-- Space Reservation Control -->
        <StackPanel Spacing="6" Margin="0,8,0,0">
          <TextBlock Text="SPACE RESERVATION" Classes="section-header" FontSize="11" />
          <TextBlock Text="{Binding SpaceReservationSummaryText}" Classes="caption" Foreground="{DynamicResource ZuneAccentBrush}" />
          <Grid ColumnDefinitions="*,Auto" MaxWidth="500" HorizontalAlignment="Left" Margin="0,4,0,0">
            <Slider Grid.Column="0" 
                    Value="{Binding SpaceReservationPercent}" 
                    Minimum="0" 
                    Maximum="50" 
                    SmallChange="5" 
                    LargeChange="10" 
                    Width="320" 
                    HorizontalAlignment="Left" />
            <TextBlock Grid.Column="1" 
                       Text="{Binding SpaceReservationPercent, StringFormat={}{0}%}" 
                       Classes="body" 
                       FontWeight="Bold" 
                       VerticalAlignment="Center" 
                       Margin="12,0,0,0" />
          </Grid>
        </StackPanel>
      </StackPanel>

      <!-- Sync Button & Progress -->
      <StackPanel Spacing="12">
        <Button Classes="zune-action" Command="{Binding SyncCommand}" HorizontalAlignment="Left">
          <TextBlock Text="SYNC TO DEVICE" Classes="section-header" />
        </Button>
        <ProgressBar Value="{Binding SyncProgress}" Maximum="1.0" Height="4" CornerRadius="0"
                     Foreground="{DynamicResource ZuneAccentBrush}" Background="{DynamicResource ZuneSurfaceElevatedBrush}" />
      </StackPanel>
    </StackPanel>

    <!-- State 2: No Device Connected -->
    <StackPanel IsVisible="{Binding !HasDevice}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
      <Image Source="avares://NotZune.UI/Assets/Zune/Branding/ZUNEHDDEVICES.PNG" Width="64" Height="74" HorizontalAlignment="Center" Margin="0,0,0,8" />
      <TextBlock Text="connect a zune" Classes="hero" HorizontalAlignment="Center" />
      <TextBlock Text="Attach your Zune 30, Zune 4/8/16, Zune 80/120, or Zune HD via USB cable." 
                 Classes="body" 
                 Foreground="{DynamicResource ZuneTextSecondaryBrush}"
                 HorizontalAlignment="Center" />
    </StackPanel>
  </Grid>
</UserControl>
