<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:NotZune.UI.Views;assembly=NotZune.UI"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="780"
        x:Class="NotZune.Desktop.MainWindow"
        Title="Not-Zune"
        Width="1240" Height="780"
        MinWidth="734" MinHeight="500"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="{DynamicResource ZuneBackgroundBrush}">

  <views:MainShellView />
</Window>
