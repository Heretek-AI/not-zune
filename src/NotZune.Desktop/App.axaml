<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:NotZune.UI;assembly=NotZune.UI"
             x:Class="NotZune.Desktop.App"
             RequestedThemeVariant="Dark">
  <Application.DataTemplates>
    <ui:ViewLocator />
  </Application.DataTemplates>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://NotZune.UI/Styles/ZuneTheme.axaml" />
  </Application.Styles>
</Application>
